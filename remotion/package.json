{
  "name": "cycling-reels-template",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion template that renders 9:16 cycling Reels from a props file written by the reels CLI",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts CyclingReel",
    "typecheck": "tsc --noEmit",
    "build:editor-preview": "node scripts/build-editor-preview.mjs"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/rye": "5.3.0",
    "@fontsource/tiktok-sans": "5.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.1",
    "typescript": "5.6.3"
  }
}
