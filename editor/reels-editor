#!/usr/bin/env bash
# Reels Editor launcher: setup | open [plan] | info.
# The editor is part of this repo: it uses the repo's .venv and remotion/, and
# edits the real plans/ folder. It never sources .env.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
APP_NAME="Reels Editor.app"
APP="$HOME/Applications/$APP_NAME"
BUNDLE_ID="com.cycling.ReelsEditor"
BUILD_DIR="$REPO/.cache/editor/build"

say()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
fail() { printf '\n\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

usage() {
  cat <<USAGE
Usage: editor/reels-editor <command>
  setup        install dependencies, build the app, copy it to ~/Applications/Reels Editor.app
  open [plan]  open the app on this folder (optionally a plan, e.g. plans/2026-11-15-x.json)
  info         show where everything lives
USAGE
}

built_app() {
  # The Swift project decides the product name; take whatever .app was built.
  local found
  found="$(find "$BUILD_DIR/Build/Products/Release" -maxdepth 1 -name '*.app' -type d 2>/dev/null | head -n 1)"
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

cmd_setup() {
  [ "$(uname -s)" = Darwin ] || fail "The Reels Editor requires macOS."
  command -v xcodebuild >/dev/null 2>&1 && xcodebuild -version >/dev/null 2>&1 \
    || fail "Install and select full Xcode (xcode-select), then retry."
  command -v sandbox-exec >/dev/null 2>&1 || fail "sandbox-exec is required; renderer code never runs unsandboxed."
  command -v node >/dev/null 2>&1 || fail "Node 18+ is required (brew install node)."
  command -v ffmpeg >/dev/null 2>&1 || fail "ffmpeg is required (brew install ffmpeg)."

  if [ ! -x "$REPO/.venv/bin/python" ]; then
    say "Creating the Python environment (.venv)"
    local py=""
    for cand in python3.12 python3.13 python3.11 python3.10 python3; do
      if command -v "$cand" >/dev/null 2>&1 && "$cand" -c 'import sys; raise SystemExit(0 if (3,10) <= sys.version_info[:2] <= (3,13) else 1)' 2>/dev/null; then
        py="$cand"; break
      fi
    done
    [ -n "$py" ] || fail "Python 3.10-3.13 is required (brew install python@3.12)."
    "$py" -m venv "$REPO/.venv"
  fi
  say "Python packages (requirements.txt)"
  "$REPO/.venv/bin/python" -m pip install --quiet --upgrade pip
  "$REPO/.venv/bin/python" -m pip install --quiet -r "$REPO/requirements.txt"

  say "Remotion dependencies"
  # Always run: it is quick when up to date, and picks up packages the editor
  # added (e.g. @remotion/player) to an existing node_modules.
  ( cd "$REPO/remotion" && npm install --no-audit --no-fund --loglevel=error )
  say "Building the editor preview bundle"
  npm --prefix "$REPO/remotion" run build:editor-preview

  say "Building the offline Metal sphere renderer"
  "$REPO/editor/tools/reels-sphere/build"

  say "Building the app (Release)"
  mkdir -p "$BUILD_DIR"
  xcodebuild -project "$REPO/editor/ReelsEditor.xcodeproj" -scheme ReelsEditor -configuration Release \
    -derivedDataPath "$BUILD_DIR" build | tail -n 5

  local product
  product="$(built_app)" || fail "The build finished but no .app was found in $BUILD_DIR/Build/Products/Release."

  say "Installing to $APP"
  mkdir -p "$HOME/Applications"
  # Replace only an existing copy of this exact app bundle; nothing else is touched.
  if [ -d "$APP" ]; then
    case "$APP" in
      "$HOME/Applications/Reels Editor.app") rm -rf "$APP" ;;
      *) fail "refusing to replace $APP" ;;
    esac
  fi
  ditto "$product" "$APP"
  defaults write "$BUNDLE_ID" reelsEditor.repositoryRoot "$REPO"

  if ! command -v claude >/dev/null 2>&1; then
    printf '\033[33mClaude Code is optional for manual editing. Install it and sign in for chat and semantic search.\033[0m\n' >&2
  fi
  cat <<DONE

Reels Editor is installed: $APP
It edits the real plans/ in $REPO and never touches your original footage.

To keep it in the Dock: open it once (editor/reels-editor open or Finder > Applications),
then right-click its Dock icon > Options > Keep in Dock.
DONE
}

cmd_open() {
  [ -d "$APP" ] || fail "Reels Editor is not installed yet. Run: editor/reels-editor setup"
  local args=(--repo "$REPO")
  if [ -n "${1:-}" ]; then
    local plan="$1"
    case "$plan" in "$REPO"/*) plan="${plan#"$REPO"/}" ;; esac
    args+=(--plan "$plan")
  fi
  exec open "$APP" --args "${args[@]}"
}

cmd_info() {
  cat <<INFO
repo:        $REPO
plans:       $REPO/plans   (edited directly)
originals:   $REPO/library/media   (read-only to the editor)
python:      $REPO/.venv
remotion:    $REPO/remotion
editor state: $REPO/.cache/editor/live
build:       $BUILD_DIR
app:         $APP $( [ -d "$APP" ] && echo "(installed)" || echo "(not installed - run setup)" )
Claude Code: $(command -v claude || echo "not found")
INFO
}

case "${1:-}" in
  setup) cmd_setup ;;
  open) shift; cmd_open "${1:-}" ;;
  info) cmd_info ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
